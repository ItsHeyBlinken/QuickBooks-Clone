{
  "name": "ledgerlocal",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first desktop accounting software",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ledgerlocal/desktop",
    "build": "npm run build --workspace=@ledgerlocal/desktop",
    "marketing:preview": "npx --yes serve docs/marketing -p 4173",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
