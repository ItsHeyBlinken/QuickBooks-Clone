# LedgerLocal marketing site — copy to /etc/nginx/sites-available/ledgerlocal
#
# Serves the deploy branch root (e.g. gh-pages) where index.html lives at /.
# Replace YOUR_DOMAIN and REPO_PATH (clone root, not docs/marketing).

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    # Redirect HTTP → HTTPS (uncomment after certbot)
    # return 301 https://$host$request_uri;
}

server {
    # Uncomment after: sudo certbot --nginx -d YOUR_DOMAIN
    # listen 443 ssl http2;
    # listen [::]:443 ssl http2;
    # server_name YOUR_DOMAIN;
    #
    # ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    root REPO_PATH;
    index index.html;

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    location ~* \.(css|js|ico|png|jpg|jpeg|gif|webp|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache";
    }

    location = /onboarding.html {
        expires -1;
        add_header Cache-Control "no-cache";
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /var/log/nginx/ledgerlocal-access.log;
    error_log  /var/log/nginx/ledgerlocal-error.log;
}
